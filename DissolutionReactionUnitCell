def circlebox(l, w, r):
    gx = w - 2*r
    gy = l - 2*r
    im = Image.new('RGB', (w, l), (0, 0, 0))
    draw = ImageDraw.Draw(im)
    draw.ellipse(xy = (-r, -r, r, r),
                fill = (255, 255, 255, 255),
                outline = (255, 255, 255),
                width = 0)
    draw.ellipse(xy = (r + gx, -r, w + r, r),
                fill = (255, 255, 255, 255),
                outline = (255, 255, 255),
                width = 0)
    draw.ellipse(xy = (-r, r + gy, r, l + r),
                fill = (255, 255, 255, 255),
                outline = (255, 255, 255),
                width = 0)
    draw.ellipse(xy = (r + gx, r + gy, w + r, l + r),
                fill = (255, 255, 255, 255),
                outline = (255, 255, 255),
                width = 0)
    return im

def ManifestInitWriter(name, microstructure):
    im = microstructure.astype(int)
    
    with open(name, 'w') as outfile:
        for row in range(microstructure.shape[0]):
            for col in range(microstructure.shape[1]):
                if im[row, col] == 1:
                    state = "A"
                else:
                    state = "B"
                outfile.write(state + " ")
            if row < 200:
                outfile.write("\n")

def simulate_without_display(manifest_file):
    '''
    Run until completion or max time, storing an array of species counts at
    the times of each reaction, along with an array of times. At the end,
    display a graph of species concentrations as they change.
    '''

    manifest_options = read_manifest(manifest_file)
    opts = SurfaceCRNOptionParser(manifest_options)
    simulator = QueueSimulator(surface = opts.grid,
                               transition_rules = opts.transition_rules,
                               seed = opts.rng_seed,
                               simulation_duration = opts.max_duration)
    times = [0]
    concs = dict()
    for species in species_tracked:
        concs[species] = [0]
    for node in opts.grid:
        if node.state in concs:
            concs[node.state][0] += 1
    print(concs)
    while not simulator.done():
        next_rxn = simulator.process_next_reaction()
        if next_rxn is None:
            break
        times.append(next_rxn.time)
        for species in species_tracked:
            concs[species].append(concs[species][-1])
        for reactant in next_rxn.rule.inputs:
            if reactant in concs:
                concs[reactant][-1] -= 1
        for product in next_rxn.rule.outputs:
            if product in concs:
                concs[product][-1] += 1

    # for species in species_tracked:
    #    plt.plot(times, concs[species], label = species)
    # plt.legend()
    # plt.xlabel("Time (s)")
    # plt.ylabel("Packet Count (#)")
    # plt.title("Evolution of Reaction Species")
    # plt.show()
    
    return concs, times

def Keqcalc(data):
    Rmean = np.mean(data['P'][-500:])
    Qmean = np.mean(data['B'][-500:])
    Amean = np.mean(data['A'][-500:])
    
    return (Rmean)/(Qmean * Amean)

def delete_adjacent_duplicates(df, columns):
    """
    Deletes rows in a DataFrame if the values in specified columns are the same
    and the rows are next to each other.

    Parameters:
        df (pd.DataFrame): The input DataFrame.
        columns (list): The columns to check for duplicate values.

    Returns:
        pd.DataFrame: A DataFrame with adjacent duplicate rows removed.
    """
    # Use the shift method to compare each row with the previous one
    mask = df[columns].shift() != df[columns]

    # Keep rows where at least one column is different or it's the first row
    filtered_df = df[mask.any(axis=1)]

    return filtered_df

def save_every_nth_row(df, file_name, n):
    """
    Saves every nth row of a DataFrame into a CSV file.

    Parameters:
        df (pd.DataFrame): The input DataFrame.
        file_name (str): The name of the output CSV file.
        n (int): The step size for selecting rows.

    Returns:
        None
    """
    every_nth_row = df.iloc[::n]
    every_nth_row.to_csv(file_name, index=False)

